{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["netlify/functions/**/*.ts", "server/**/*.ts", "src/data/**/*.ts", "src/types/**/*.ts"]
}
